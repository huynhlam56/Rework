# Postgres connection string (Neon in production, local/Prisma Postgres in dev).
# See: npx prisma dev (local) or npx create-db (free hosted Prisma Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/rewear?schema=public"

# Bearer token the GitHub Actions ingestion step must present to POST results to /api/ingest.
TEST_INGEST_TOKEN="change-me"

# Password gate for the /admin test-metrics dashboard.
ADMIN_PASSWORD="change-me"
