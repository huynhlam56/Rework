// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingCondition {
  NEW_WITH_TAGS
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listings Listing[] @relation("SellerListings")
  orders   Order[]   @relation("BuyerOrders")
}

model Listing {
  id          String           @id @default(cuid())
  title       String
  description String
  priceCents  Int
  category    String
  size        String
  condition   ListingCondition
  status      ListingStatus    @default(ACTIVE)
  imageUrls   String[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sellerId String
  seller   User   @relation("SellerListings", fields: [sellerId], references: [id])

  orderItems OrderItem[]

  @@index([sellerId])
  @@index([status])
}

model Order {
  id            String      @id @default(cuid())
  status        OrderStatus @default(PENDING)
  totalCents    Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])

  items OrderItem[]

  @@index([buyerId])
}

model OrderItem {
  id         String @id @default(cuid())
  priceCents Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  @@index([orderId])
  @@index([listingId])
}

enum TestRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERRORED
}

enum TestRunTrigger {
  MANUAL
  CI
}

enum TestResultStatus {
  PASSED
  FAILED
  SKIPPED
}

model TestRun {
  id          String         @id @default(cuid())
  status      TestRunStatus  @default(QUEUED)
  trigger     TestRunTrigger @default(MANUAL)
  startedAt   DateTime?
  finishedAt  DateTime?
  errorMessage String?
  createdAt   DateTime       @default(now())

  results TestResult[]
}

model TestResult {
  id           String            @id @default(cuid())
  testFile     String
  testTitle    String
  status       TestResultStatus
  durationMs   Int
  errorMessage String?

  runId String
  run   TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}
